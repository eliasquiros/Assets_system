# Copiar a .env y ajustar valores locales. .env nunca se sube al repositorio.

# Clave de firma de los JWT. El claim `tenant` de esos tokens es la UNICA fuente
# de verdad de a que empresa pertenece cada request (RS-002): quien tenga esta
# clave puede forjar un token para CUALQUIER empresa. Una distinta por entorno,
# larga y aleatoria. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si se omite en dev, se genera una efimera por arranque (las sesiones se caen
# al reiniciar). Con DJANGO_DEBUG apagado es OBLIGATORIA: el proceso no levanta.
DJANGO_SECRET_KEY=

# Solo el valor 'true' (sin importar mayusculas) enciende el modo debug.
# Cualquier otra cosa —incluido no definir la variable— lo deja APAGADO, que es
# el default seguro: DEBUG encendido en produccion publica tracebacks con toda
# la configuracion y apaga HTTPS forzado, HSTS y el flag Secure de las cookies.
# En produccion: dejar vacio o poner false.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Cuantos proxies inversos hay REALMENTE delante de la app. Es lo que permite
# identificar al cliente para el rate limiting: sin esto, DRF usa la cabecera
# X-Forwarded-For completa —que el cliente controla— y el limite de login se
# evade rotandola en cada intento (fuerza bruta sin freno).
#   1 = solo Render (valor por defecto)
#   2 = Cloudflare delante de Render
# Verificar tras desplegar (ver docs); un valor mayor al real vuelve a leer una
# posicion que el atacante controla, y uno menor mete a todos en el mismo balde.
DJANGO_NUM_PROXIES=1

# Conexion a PostgreSQL local (DA01/DA02). Ajustar segun tu instancia.
DB_NAME=activos_fijos
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5430

# Origenes permitidos para CSRF (subdominios del frontend). En dev, los
# origenes literales de Vite bastan. En produccion, usar un comodin que
# cubra todos los subdominios de empresas, ej: https://*.sistema.com (DA16).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://demo.localhost:5173

# --- Produccion (API unica: backend en api.sistema.com). En dev, sin definir. ---
# En prod: DJANGO_ALLOWED_HOSTS=api.sistema.com y DJANGO_DEBUG=False.
#
# Regex ANCLADO de origenes del frontend permitidos por CORS (coma-separado). El
# ancla ^...$ es obligatoria: sin ella matchea https://evil-sistema.com y, con
# credenciales, cualquier origen podria leer respuestas. Ej:
# DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.sistema\.com$
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=

# SameSite de las cookies de auth. En prod el frontend (*.sistema.com) y el
# backend (api.sistema.com) son cross-origin: la cookie httpOnly solo viaja con
# None (+ Secure, que se activa solo cuando DEBUG=False). En dev dejar sin
# definir (Lax, mismo origen via proxy de Vite).
DJANGO_AUTH_COOKIE_SAMESITE=

# Dominio de la cookie csrftoken. En prod, el dominio PADRE con punto inicial
# (ej. .sistema.com) para que el JS del frontend la lea y viaje a la API. En dev
# dejar sin definir (host-only). Los JWT NO usan esto: siguen host-only.
DJANGO_CSRF_COOKIE_DOMAIN=

# Conexion a Postgres/Supabase. Con el pooler de Supabase usar modo SESION
# (DB_PORT=5432) o conexion directa, NUNCA modo transaccion (DB_PORT=6543):
# django-tenants fija el schema via search_path por conexion, y el pooling
# transaccional puede entregar otro backend a mitad de request y devolver datos
# de OTRA empresa sin error ni rastro en los logs (RS-002).
# En el panel de Supabase los dos poolers aparecen juntos y solo cambia el
# puerto: copiar el string equivocado es un error de un caracter. Por eso el
# arranque falla cerrado si detecta el puerto 6543 (ver config/env.py).
# DB_SSLMODE=require y DB_HOST/DB_PORT apuntando al pooler en modo sesion.
DB_SSLMODE=
DB_CONN_MAX_AGE=0

# Token secreto que protege los DOS endpoints internos disparados por pg_cron
# via pg_net. Generar uno largo y aleatorio. Vacio => ambos endpoints responden
# 503. Hay que agendar las DOS tareas en Supabase, no solo la primera: sin la
# segunda, las bajas se quedan "vencidas" en la UI para siempre porque nada las
# pasa a DEFINITIVA (RN-002.4/DA14). Ver docs/guia_deploy.md#2.6 para el detalle.
#
#   select cron.schedule('depreciacion-mensual', '0 6 1 * *', $$
#     select net.http_post(
#       url := 'https://<host-del-backend>/api/internal/depreciacion/',
#       headers := jsonb_build_object('X-Internal-Token', '<mismo-token>')
#     );
#   $$);
#   select cron.schedule('promover-retiros-diario', '10 6 * * *', $$
#     select net.http_post(
#       url := 'https://<host-del-backend>/api/internal/promover-retiros/',
#       headers := jsonb_build_object('X-Internal-Token', '<mismo-token>')
#     );
#   $$);
DJANGO_INTERNAL_TASK_TOKEN=

# --- Supabase Storage: comprobantes de baja (RS-005) ---
# Bucket PRIVADO donde viven los respaldos de las bajas. Sin estas tres
# variables el backend guarda los archivos en el disco del contenedor, que en
# Render se borra en cada despliegue; por eso fuera de DEBUG el arranque falla
# cerrado si faltan (ver config/env.py).
#
# Crear una sola vez en el panel de Supabase, Storage > New bucket:
#   - Name: respaldos-retiro
#   - Public bucket: DESACTIVADO (el acceso va con enlace firmado, RS-005)
#
# SUPABASE_URL es la Project URL (Settings > API). SUPABASE_SERVICE_KEY es la
# clave service_role: es secreta, salta las policies de RLS y NUNCA debe
# llegar al frontend ni al repositorio.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_RESPALDOS=respaldos-retiro
